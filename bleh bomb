-- Helper: Bind hotkey on PC, create tap button on mobile
local function bindHotkey(tab, toggle, key, buttonName)
    if not isMobile then
        tab:CreateKeybind({
            Name = buttonName .. " Hotkey",
            CurrentKeybind = key.Name,
            HoldToInteract = false,
            Callback = function()
                local newState = not toggle.CurrentValue
                toggle:Set(newState)
                -- Manually fire toggle callback logic if needed (Rayfield handles Set internally)
            end
        })
    else
        tab:CreateButton({
            Name = buttonName .. " (Tap Toggle)",
            Callback = function()
                local newState = not toggle.CurrentValue
                toggle:Set(newState)
                -- Note: Rayfield's toggle callback fires on Set()
            end
        })
    end
end

