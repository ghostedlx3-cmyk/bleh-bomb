-- Lag Switch
PlayerTab:CreateSection("Lag Switch")

local lagEnabled = false
local seatHolder, vehicleSeat, weld, lagConnection, animate

local function createSeat()
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:WaitForChild("HumanoidRootPart")
    seatHolder = Instance.new("Part"); seatHolder.Size = Vector3.new(1.5, 1.5, 1.5)
    seatHolder.Position = hrp.Position + Vector3.new(0, 5, 0); seatHolder.Anchored = true
    seatHolder.CanCollide = false; seatHolder.Transparency = 1; seatHolder.Parent = workspace
    vehicleSeat = Instance.new("VehicleSeat"); vehicleSeat.Parent = seatHolder
    vehicleSeat.Position = seatHolder.Position + Vector3.new(0, 1, 0)
    vehicleSeat.CanCollide = false; vehicleSeat.Transparency = 1
    weld = Instance.new("Weld"); weld.Part0 = hrp; weld.Part1 = vehicleSeat; weld.Parent = vehicleSeat
end

local function removeSeat()
    if weld then weld:Destroy() end
    if vehicleSeat then vehicleSeat:Destroy() end
    if seatHolder then seatHolder:Destroy() end
    weld, vehicleSeat, seatHolder = nil, nil, nil
end

local function toggleLag(state)
    lagEnabled = state
    local character = LocalPlayer.Character
    if lagEnabled then
        if character then
            createSeat()
            lagConnection = RunService.Heartbeat:Connect(function()
                for _ = 1, 500 do workspace:FindFirstChild("NonExistentObject") end
            end)
            animate = character:FindFirstChild("Animate")
            if animate then animate.Parent = nil end
        end
        Rayfield:Notify({ Title = "Lag Switch", Content = "Activated", Duration = 3 })
    else
        if lagConnection then lagConnection:Disconnect(); lagConnection = nil end
        removeSeat()
        if character and animate then animate.Parent = character end
        Rayfield:Notify({ Title = "Lag Switch", Content = "Deactivated", Duration = 3 })
    end
end

local lagSwitchToggle = PlayerTab:CreateToggle({
    Name = "Enable Lag Switch",
    CurrentValue = false,
    Flag = "LagSwitch",
    Callback = function(state) toggleLag(state) end
})

bindHotkey(PlayerTab, lagSwitchToggle, Enum.KeyCode.T, "Lag Switch")

game.Players.LocalPlayer.CharacterAdded:Connect(function()
    if lagEnabled then toggleLag(false); task.wait(1); toggleLag(true) end
end)

