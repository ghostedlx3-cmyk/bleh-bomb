            Rayfield:Notify({ Title = "TP Walk", Content = "Enabled", Duration = 3 })
        else
            if tpWalkConnection then task.cancel(tpWalkConnection); tpWalkConnection = nil end
            Rayfield:Notify({ Title = "TP Walk", Content = "Disabled", Duration = 3 })
